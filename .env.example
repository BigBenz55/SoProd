# Accès au back-office (/admin)
NUXT_ADMIN_PASSWORD=choisissez-un-mot-de-passe-long
# Clé de signature des sessions (32 caractères aléatoires minimum)
NUXT_SESSION_SECRET=remplacez-par-une-longue-chaine-aleatoire

# --- Cache WebP sur le serveur Node (pas les photos clients) ---
# Local :
NUXT_DATA_DIR=./.data
# Hostinger : dossier RÉEL sous votre compte (File Manager), chemin absolu :
# NUXT_DATA_DIR=/home/VOTRE_UID/domains/VOTRE-DOMAINE.hostingersite.com/private/soprod-cache

# --- Métadonnées du site (galeries, liens, favoris, index des fichiers) ---
# Local : rien à mettre → SQLite dans NUXT_DATA_DIR/soprod.db
# Hostinger (recommandé) : une seule URL MySQL (mot de passe encodé si caractères spéciaux : %40 pour @, etc.)
# NUXT_DATABASE_URL=mysql://UTILISATEUR:MOT_DE_PASSE@localhost:3306/NOM_DE_LA_BASE
# Alternative : variables séparées
# NUXT_DB_DRIVER=mysql
# NUXT_DB_MYSQL_HOST=localhost
# NUXT_DB_MYSQL_PORT=3306
# NUXT_DB_MYSQL_DATABASE=
# NUXT_DB_MYSQL_USER=
# NUXT_DB_MYSQL_PASSWORD=

# --- Photos & vidéos ORIGINALES (Box chez vous) : FTP/FTPS, pas une « base de données » ---
# local = dossier demo-box (dev) | ftp | sftp
NUXT_STORAGE_DRIVER=local
NUXT_STORAGE_ROOT=./demo-box

# Production — Box accessible depuis Internet (DNS dynamique, ports ouverts vers la Box) :
# NUXT_STORAGE_DRIVER=ftp
# NUXT_STORAGE_HOST=monstudio.duckdns.org
# NUXT_STORAGE_PORT=21
# NUXT_STORAGE_USER=soprod
# NUXT_STORAGE_PASSWORD=
# NUXT_STORAGE_SECURE=true
# Freebox : le FTP ouvre souvent /Freebox (Photos, Client 1, Vidéos…)
# NUXT_STORAGE_ROOT=/Freebox
# NUXT_STORAGE_PRIVATE_KEY_PATH=   (SFTP uniquement)

# Coordonnées affichées sur la vitrine
NUXT_PUBLIC_CONTACT_EMAIL=
NUXT_PUBLIC_INSTAGRAM=
